Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dBrFreeExtended", " ", "[", 
    RowBox[{
    "s_", ",", "Mbmeson_", ",", " ", "Mkaon_", ",", " ", "Mlepton_", ",", 
     "lep_", ",", "supp_", ",", " ", "\[CapitalGamma]fulll_", ",", " ", 
