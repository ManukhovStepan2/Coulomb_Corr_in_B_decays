     "FzeroT_", ",", " ", "sigmaT1_", ",", " ", "sigmaT2_"}], "]"}], " ", "=",
    " ", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["Gfermi", "2"], " ", 
      SuperscriptBox["Mbmeson", "5"], 
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{"VtqVtb", "[", "supp", "]"}], "]"}], "2"], 
      SuperscriptBox["\[Alpha]", "2"]}], 
     RowBox[{"\[CapitalGamma]fulll", " ", "1536", " ", 
      SuperscriptBox["Pi", "5"]}]], 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      FractionBox["1", "4"], " ", "-", " ", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{"mhat", "[", 
         RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}]}], "s"]}], "]"}], 
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Phi]", "[", 
      RowBox[{"s", " ", ",", "Mbmeson", ",", "Mkaon"}], "]"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"mhat", "[", 
            RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}]}], "s"]}], ")"}], 
       RowBox[{"\[Phi]", "[", 
        RowBox[{"s", ",", "Mbmeson", ",", "Mkaon"}], "]"}], 
       RowBox[{"\[Beta]p", "[", 
        RowBox[{
        "s", ",", " ", "Mbmeson", ",", "Mkaon", ",", "Mvec", ",", " ", "lep", 
         ",", " ", "supp", ",", " ", "FzeroT", ",", " ", "sigmaT1", ",", " ", 
