         "sigmaP2"}], "]"}]}], " ", "+", " ", 
      RowBox[{"12", " ", 
       RowBox[{"mhat", "[", 
        RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}], " ", 
       RowBox[{"\[Delta]p", "[", 
