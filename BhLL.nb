Cell["\:0412\:0441\:043f\:043e\:043c\:043e\:0433\:0430\:0442\:0435\:043b\:044c\
\:043d\:0430\:044f \:0444\:0443\:043d\:043a\:0446\:0438\:044f h(m,s):", "Text",
 CellChangeTimes->{{3.9276095074073887`*^9, 3.927609530607226*^9}, 
   3.927611170196746*^9},ExpressionUUID->"f985043f-329a-44fd-b572-\
b546e48dc515"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"m_", ",", "s_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["8", "9"]}], 
      RowBox[{"Log", "[", "m", "]"}]}], "+", 
     FractionBox["8", "27"], "+", 
     RowBox[{
      FractionBox["4", "9"], 
      FractionBox[
       RowBox[{"4", 
        SuperscriptBox["m", "2"]}], "s"]}], " ", "-", 
     RowBox[{
      FractionBox["2", "9"], 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        FractionBox[
         RowBox[{"4", 
          SuperscriptBox["m", "2"]}], "s"]}], ")"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"4", 
           SuperscriptBox["m", "2"]}], "s"]}], "]"}], "]"}], " ", 
