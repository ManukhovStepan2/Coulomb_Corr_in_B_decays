Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tMand", "[", 
    RowBox[{
    "s_", ",", "cos_", ",", "Mbmeson_", ",", " ", "Mkaon_", ",", "Mlepton_"}],
     "]"}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"rhat", "[", 
       RowBox[{"Mkaon", ",", "Mbmeson"}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"mhat", "[", 
        RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}]}], " ", "-", " ", "s", "+", 
      RowBox[{
       RowBox[{"Sqrt", "[", " ", 
        RowBox[{"1", "-", 
         RowBox[{"4", " ", 
          FractionBox[
           RowBox[{"mhat", "[", 
            RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}], "s"]}]}], "]"}], 
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[Phi]", "[", 
         RowBox[{"s", ",", "Mbmeson", ",", " ", "Mkaon"}], "]"}], "]"}], 
       "cos"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPi]", "[", 
    RowBox[{
    "s_", ",", "cos_", ",", "Mbmeson_", ",", " ", "Mkaon_", ",", "Mlepton_"}],
     "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"tMand", "[", 
        RowBox[{
        "s", ",", "cos", ",", "Mbmeson", ",", " ", "Mkaon", ",", "Mlepton"}], 
        "]"}], "-", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"tMand", "[", 
        RowBox[{
        "s", ",", "cos", ",", "Mbmeson", ",", " ", "Mkaon", ",", "Mlepton"}], 
        "]"}], "-", 
       RowBox[{"rhat", "[", 
        RowBox[{"Mkaon", ",", "Mbmeson"}], "]"}]}], ")"}]}], "+", 
    RowBox[{"s", " ", 
     RowBox[{"tMand", "[", 
      RowBox[{
      "s", ",", "cos", ",", "Mbmeson", ",", " ", "Mkaon", ",", "Mlepton"}], 
      "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"mhat", "[", 
      RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"rhat", "[", 
        RowBox[{"Mkaon", ",", "Mbmeson"}], "]"}], " ", "+", 
       RowBox[{"mhat", "[", 
        RowBox[{"Mlepton", ",", "Mbmeson"}], "]"}], " ", "-", " ", "s", " ", "-",
        " ", 
       RowBox[{"2", 
        RowBox[{"tMand", "[", 
         RowBox[{
         "s", ",", "cos", ",", "Mbmeson", ",", " ", "Mkaon", ",", "Mlepton"}],
          "]"}]}]}], ")"}]}]}]}], ";"}]}], "Input",
